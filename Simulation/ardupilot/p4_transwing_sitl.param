# P4 Transwing ArduPlane QuadPlane overrides for Gazebo Harmonic.
# This file is simulation-only. It must not be loaded onto a real aircraft.

Q_ENABLE 1
Q_FRAME_CLASS 1
Q_FRAME_TYPE 1

# All four motors move with the two wing assemblies. ArduPilot documents mask
# 15 for a tilt-quadplane whose four motors all transition. A single common
# MotorTilt output is duplicated to the left and right fold joints in SDF.
Q_TILT_ENABLE 1
Q_TILT_MASK 15
Q_TILT_TYPE 0
# Q_TILT_MAX is the airspeed-wait angle, not the final cruise angle. Holding
# the surrogate at 45 deg produced a 25+ deg pitch excursion before it had
# enough airspeed for the V-tail. Use a shallow 20 deg wait angle, then allow
# the TIMER phase to command the complete physical wing fold.
Q_TILT_MAX 20
# RATE_UP is forward-flight -> hover recovery; RATE_DN is hover -> forward.
# Keep recovery brisk while building forward tilt conservatively.
# The compound fold has a mid-travel aerodynamic dead zone: the wing is not
# yet useful for fixed-wing lift while rotor vertical thrust is already lower.
Q_TILT_RATE_DN 20
Q_TILT_RATE_UP 25

# Standard Quad-X outputs:
# 1 front-right, 2 rear-left, 3 front-left, 4 rear-right.
SERVO1_FUNCTION 33
SERVO1_MIN 1000
SERVO1_MAX 2000
SERVO1_TRIM 1000
SERVO1_REVERSED 0

SERVO2_FUNCTION 34
SERVO2_MIN 1000
SERVO2_MAX 2000
SERVO2_TRIM 1000
SERVO2_REVERSED 0

SERVO3_FUNCTION 35
SERVO3_MIN 1000
SERVO3_MAX 2000
SERVO3_TRIM 1000
SERVO3_REVERSED 0

SERVO4_FUNCTION 36
SERVO4_MIN 1000
SERVO4_MAX 2000
SERVO4_TRIM 1000
SERVO4_REVERSED 0

# Common tilt-wing command. 1000 us is folded hover and 2000 us is cruise.
SERVO5_FUNCTION 41
SERVO5_MIN 1000
SERVO5_MAX 2000
SERVO5_TRIM 1000
SERVO5_REVERSED 0

# One ArduPlane aileron output is duplicated to four physical aileron joints.
SERVO6_FUNCTION 4
SERVO6_MIN 1100
SERVO6_MAX 1900
SERVO6_TRIM 1500
SERVO6_REVERSED 0

# V-tail mixer outputs.
SERVO7_FUNCTION 79
SERVO7_MIN 1100
SERVO7_MAX 1900
SERVO7_TRIM 1500
SERVO7_REVERSED 0

SERVO8_FUNCTION 80
SERVO8_MIN 1100
SERVO8_MAX 1900
SERVO8_TRIM 1500
SERVO8_REVERSED 0

# The default 0.5 V-tail mixer gain halved the elevator request during
# transition while the front motor pair saturated. Full gain preserves the
# controller demand; servo limits still bound each surface to +/-25 degrees.
MIXING_GAIN 1.0

# Conventional RC input range and failsafe below the legal throttle range.
RC3_MIN 1000
RC3_TRIM 1500
RC3_MAX 2000
RC3_DZ 30
THR_FAILSAFE 1
THR_FS_VALUE 950

# The calibrated ArduPilot blade-section model hovers at about 59-60% motor
# output at 40.5 kg. Start near that measured SITL value instead of requiring
# the vertical controller to unwind the old 0.84 open-loop estimate.
Q_M_THST_HOVER 0.60
Q_M_HOVER_LEARN 2
# Limit the initial climb and QLOITER correction while the folded-wing mass
# and inertia are still estimates. This reduces the lift-off pitch transient
# without weakening the rate controller itself.
Q_PILOT_SPD_UP 0.7
Q_PILOT_SPD_DN 1.0
Q_LOIT_SPEED_MS 1.5
# Cap both the loiter pilot request and the autonomous NE position controller.
# Q_LOIT_ANG_MAX alone does not constrain the position correction generated
# after a folded-wing lift-off disturbance.
Q_LOIT_ANG_MAX 6
Q_P_ANGLE_MAX 6
Q_A_ANGLE_MAX 15
# The folded P4 has much more pitch inertia and an offset centre of gravity
# than the small QuadPlane used for the default gains. Keep QLOITER's horizontal
# corrections gentle and reduce the angle-to-pitch-rate gain so it does not
# repeatedly throw the nose past the requested attitude after reaching height.
Q_LOIT_ACC_MAX_M 1.0
Q_LOIT_BRK_ACC_M 0.3
Q_LOIT_BRK_JRK_M 1.0
Q_P_JERK_NE 1.0
Q_A_ANG_PIT_P 2.5
# The folded-hover CG is now balanced, so the pitch-rate loop no longer needs
# a large integral term to hold a permanent front/rear motor split. Reducing I
# shortens the sign-reversal lag visible in PIQP without reducing P authority.
Q_A_RAT_PIT_I 0.12
Q_LAND_FINAL_SPD 0.4

# The presentation's 10-20 m/s is a mid-transition observation, not the speed
# at which the 40.5 kg wing can carry the aircraft. The published X-P4 stall
# speed is 26.75 m/s, so 27 m/s remains the fixed-wing minimum. However, the
# Transwing surrogate needs a margin while its wing is still folding: hold
# QAssist until 32 m/s, then let the VTOL contribution decay. TYPE=100 reads
# the airspeed generated by the SITL/Gazebo state.
ARSPD_TYPE 100
# Use the calibrated SITL pitot in TECS once the vehicle enters fixed-wing
# control, instead of using it only as the transition threshold detector.
ARSPD_USE 1
AIRSPEED_MIN 27
AIRSPEED_CRUISE 34
AIRSPEED_MAX 42
# Disable automatic fixed-wing QAssist while the surrogate's turn dynamics are
# being identified. Logs 00000043/44 show that the modeled pitot stream is
# treated as a valid sensor (ARSPD_TYPE=100): when it crossed 32 m/s during a
# QRTL turn, QAssist re-entered transition and moved the common MotorTilt.
# -1 disables the assist/pre-arm check, but deliberate QRTL/QLOITER/QLAND and
# the normal transition controller remain available.
Q_ASSIST_SPEED -1
# Retain the synthetic-airspeed guard as a second layer for ArduPilot builds
# which classify the Gazebo stream as synthetic.
Q_OPTIONS 4096
# Angle assist is unsafe for this surrogate: when the estimated wing model
# reaches a transient roll/pitch excursion, it reverses MotorTilt and folds
# both wings while the vehicle is still in FBWB. The dashboard transition
# watchdog and explicit ABORT/QLOITER/QLAND path provide the bounded recovery.
Q_ASSIST_ANGLE 0
# Match fixed-wing rate-controller gain scaling to the verified cruise regime.
# Leaving the ArduPlane default of 15 m/s cuts pitch authority roughly in half
# at the 27-34 m/s transition speeds.
SCALING_SPEED 34
# Fixed-wing pitch loop identified from transition DataFlash. The stock gains
# were too conservative for the 40.5 kg surrogate and full-size V-tail:
# integral authority arrived only after the aircraft had lost 15 m.
PTCH_RATE_P 0.08
PTCH_RATE_I 0.50
PTCH_RATE_FF 0.50
# QRTL begins with a large heading correction. The default 45 degree command
# over-drove this estimated airframe: log 00000044 recorded a -45 degree
# demand, -59 degree response, then an increasing roll oscillation. Use a
# bounded, slower fixed-wing turn while this surrogate is calibrated. The
# aileron sign is intentionally unchanged: the log confirmed it rolls in the
# commanded direction.
ROLL_LIMIT_DEG 25
NAVL1_PERIOD 35
NAVL1_DAMPING 0.90
RLL2SRV_RMAX 45
RLL2SRV_TCONST 0.80
RLL_RATE_FF 0.20
RLL_RATE_P 0.04
RLL_RATE_I 0.10
RLL_RATE_D 0.003
RLL_RATE_SMAX 90
# The estimated Transwing has a pronounced energy-exchange (phugoid) mode
# after its wings finish folding. Prioritize height over small speed errors,
# slow the TECS corrections, and prevent a large pitch-down command while the
# model is still carrying transition sink. These are SITL-only values.
TECS_SPDWEIGHT 0.50
TECS_TIME_CONST 8.0
TECS_THR_DAMP 0.80
TECS_PITCH_MIN -5
Q_TRANSITION_MS 12000
Q_TRANS_FAIL 30
Q_TRANS_FAIL_ACT 0

# Start conservatively and retain all checks except synthetic multi-IMU
# consistency, matching the known WSL SITL timing workaround from MiniHawk.
FLTMODE1 17
FLTMODE6 19
ARMING_SKIPCHK 16
MAV_GCS_SYSID 255

# Identify the vehicle as a VTOL tiltrotor to MAVLink ground stations.
Q_MAV_TYPE 21
