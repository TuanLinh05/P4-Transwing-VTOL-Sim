        <pose>350 600 420.6 0 0 0.05</pose>
        <geometry><box><size>34 34 1.2</size></box></geometry>
        <material>
          <ambient>0.06 0.08 0.10 1</ambient>
          <diffuse>0.12 0.18 0.24 1</diffuse>
        </material>
      </visual>

      <!-- ── Observation deck (glass box)  400–410 m ── -->
      <visual name="lm81_obs_deck">
        <pose>350 600 405 0 0 0.05</pose>
        <geometry><box><size>36 36 10</size></box></geometry>
        <material>
          <ambient>0.08 0.14 0.22 1</ambient>
