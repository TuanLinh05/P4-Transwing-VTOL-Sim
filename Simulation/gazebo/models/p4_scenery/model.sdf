      <!-- ═══════════════════════════════════════════════════════════
           LANDMARK 81  –  461 m supertall skyscraper
           Position: (350, 600) — visible from launch pad.
           Three tapered sections  +  spire  +  observation deck.
      ═══════════════════════════════════════════════════════════ -->

      <!-- ── Section 1 (base):  0 → 160 m  |  footprint 56 × 56 m ── -->
      <visual name="lm81_base">
        <pose>350 600 80 0 0 0.05</pose>
        <geometry><box><size>56 56 160</size></box></geometry>
        <material>
          <ambient>0.10 0.16 0.22 1</ambient>
          <diffuse>0.16 0.32 0.48 1</diffuse>
        </material>
      </visual>

      <!-- ── Section 2 (mid):  160 → 320 m  |  footprint 44 × 44 m ── -->
      <visual name="lm81_mid">
        <pose>350 600 240 0 0 0.05</pose>
        <geometry><box><size>44 44 160</size></box></geometry>
        <material>
          <ambient>0.11 0.18 0.24 1</ambient>
          <diffuse>0.18 0.36 0.52 1</diffuse>
        </material>
      </visual>

      <!-- ── Section 3 (crown):  320 → 420 m  |  footprint 32 × 32 m ── -->
      <visual name="lm81_crown">
        <pose>350 600 370 0 0 0.05</pose>
        <geometry><box><size>32 32 100</size></box></geometry>
        <material>
          <ambient>0.12 0.20 0.26 1</ambient>
          <diffuse>0.20 0.40 0.56 1</diffuse>
        </material>
      </visual>

      <!-- ── Roof slab  420 m ── -->
