<?xml version="1.0"?>
<model>
  <name>Transwing Surrogate</name>
  <version>0.1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <author>
    <name>P4 Transwing Clone Drone project</name>
  </author>
  <description>
    Primitive-geometry VTOL demonstrator with oblique folding wings and
    wing-mounted rotors. This is a control-development surrogate, not a
    dimensionally accurate PteroDynamics P4 model.
  </description>
</model>
