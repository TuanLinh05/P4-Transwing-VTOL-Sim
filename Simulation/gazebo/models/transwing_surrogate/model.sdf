      <pose relative_to="left_wing_link">0.18 0.24 0 0 0 0</pose>
      <inertial>
        <mass>0.08</mass>
        <inertia>
          <ixx>0.00105</ixx>
          <iyy>0.00054</iyy>
          <izz>0.00054</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="motor">
        <pose>-0.035 0 0 0 1.570796326794897 0</pose>
        <geometry>
          <cylinder><radius>0.052</radius><length>0.13</length></cylinder>
        </geometry>
        <material><ambient>0.15 0.15 0.16 1</ambient><diffuse>0.22 0.22 0.24 1</diffuse></material>
      </visual>
      <visual name="disc">
        <pose>0.055 0 0 0 1.570796326794897 0</pose>
        <geometry>
          <cylinder><radius>0.16</radius><length>0.004</length></cylinder>
        </geometry>
        <material><ambient>0.05 0.05 0.05 0.28</ambient><diffuse>0.10 0.10 0.10 0.28</diffuse></material>
        <transparency>0.72</transparency>
      </visual>
      <visual name="blade_y">
        <pose>0.058 0 0 0 0 0</pose>
        <geometry><box><size>0.012 0.31 0.018</size></box></geometry>
        <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.08 0.08 0.08 1</diffuse></material>
      </visual>
      <visual name="blade_z">
        <pose>0.058 0 0 0 0 0</pose>
        <geometry><box><size>0.012 0.018 0.31</size></box></geometry>
        <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.08 0.08 0.08 1</diffuse></material>
      </visual>
    </link>

    <link name="rotor_left_outer_link">
      <pose relative_to="left_wing_link">0.18 0.67 0 0 0 0</pose>
      <inertial>
        <mass>0.08</mass>
        <inertia>
          <ixx>0.00105</ixx><iyy>0.00054</iyy><izz>0.00054</izz>
