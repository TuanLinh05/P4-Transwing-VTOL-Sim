<?xml version="1.0"?>
<sdf version="1.9">
  <model name="transwing_surrogate">
    <self_collide>false</self_collide>
    <allow_auto_disable>false</allow_auto_disable>

    <!--
      Body axes use Gazebo FLU: +X forward, +Y left, +Z up.

      The folding links rotate 120 degrees around the normalized oblique axis
      (1, -1, 1). At full fold the transform is:

        local +X (wing leading edge / propeller thrust) -> body +Z
        local +Y (left span direction)                 -> body -X
        local -Y (right span direction)                -> body -X

      Consequently the wings become vertical and lie along the fuselage while
      both outer panels fold aft and all four rotor thrust axes become
      vertical. The right hinge axis is mirrored; using the same axis for both
      sides would incorrectly fold the right panel forward.
    -->

    <link name="base_link">
      <inertial>
        <mass>5.6</mass>
        <inertia>
          <ixx>0.16</ixx>
          <iyy>0.82</iyy>
          <izz>0.88</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>

      <collision name="fuselage_collision">
        <geometry>
          <box>
            <size>1.55 0.20 0.20</size>
          </box>
        </geometry>
      </collision>

      <visual name="fuselage_body">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://transwing_surrogate/meshes/fuselage.dae</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>0.12 0.16 0.20 1</ambient>
          <diffuse>0.20 0.28 0.36 1</diffuse>
          <specular>0.35 0.35 0.35 1</specular>
        </material>
      </visual>

      <visual name="tail_boom">
        <pose>-0.91 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://transwing_surrogate/meshes/tail_boom.dae</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>0.10 0.13 0.17 1</ambient>
          <diffuse>0.17 0.23 0.30 1</diffuse>
        </material>
      </visual>

      <!-- Small fixed wing roots keep the hinges clear of the fuselage. -->
      <visual name="inner_wing">
        <pose>0.03 0 0.03 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://transwing_surrogate/meshes/inner_wing.dae</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>0.55 0.58 0.61 1</ambient>
          <diffuse>0.75 0.78 0.81 1</diffuse>
        </material>
      </visual>

      <collision name="inner_wing_collision">
        <pose>0.03 0 0.03 0 0 0</pose>
        <geometry>
          <box>
            <size>0.31 0.44 0.045</size>
          </box>
        </geometry>
      </collision>

      <visual name="horizontal_tail">
        <pose>-1.02 0 0.02 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://transwing_surrogate/meshes/htail.dae</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>0.48 0.51 0.54 1</ambient>
          <diffuse>0.67 0.70 0.73 1</diffuse>
        </material>
      </visual>

      <visual name="vertical_tail">
        <pose>-0.98 0 0.15 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://transwing_surrogate/meshes/vtail.dae</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>0.48 0.51 0.54 1</ambient>
          <diffuse>0.67 0.70 0.73 1</diffuse>
        </material>
      </visual>

      <sensor name="imu_sensor" type="imu">
        <always_on>true</always_on>
        <update_rate>250</update_rate>
      </sensor>

      <sensor name="navsat_sensor" type="navsat">
        <pose>0.20 0 0.10 0 0 0</pose>
        <always_on>true</always_on>
        <update_rate>10</update_rate>
      </sensor>
    </link>

    <link name="left_wing_link">
      <pose relative_to="base_link">0.03 0.22 0.03 0 0 0</pose>
      <inertial>
        <pose>0 0.43 0 0 0 0</pose>
        <mass>0.65</mass>
        <inertia>
          <ixx>0.0402</ixx>
          <iyy>0.0050</iyy>
          <izz>0.0450</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="left_wing_collision">
        <pose>0 0.43 0 0 0 0</pose>
        <geometry>
          <box>
            <size>0.30 0.86 0.04</size>
          </box>
        </geometry>
      </collision>
      <visual name="left_wing">
        <pose>0 0.43 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://transwing_surrogate/meshes/wing.dae</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>0.72 0.73 0.75 1</ambient>
          <diffuse>0.88 0.89 0.91 1</diffuse>
        </material>
      </visual>
      <visual name="left_hinge_marker">
        <geometry>
          <sphere>
            <radius>0.055</radius>
          </sphere>
        </geometry>
        <material>
          <ambient>0.90 0.38 0.06 1</ambient>
          <diffuse>1.00 0.48 0.08 1</diffuse>
        </material>
      </visual>
    </link>

    <link name="right_wing_link">
