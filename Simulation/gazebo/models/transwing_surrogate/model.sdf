    <joint name="left_fold_joint" type="revolute">
      <pose relative_to="base_link">0.03 0.22 0.03 0 0 0</pose>
      <parent>base_link</parent>
      <child>left_wing_link</child>
      <axis>
        <xyz expressed_in="base_link">0.577350269 -0.577350269 0.577350269</xyz>
        <limit>
          <lower>-0.034906585</lower>
          <upper>2.129301687</upper>
          <effort>60</effort>
          <velocity>0.8</velocity>
        </limit>
        <dynamics>
          <damping>1.5</damping>
          <friction>0.15</friction>
        </dynamics>
      </axis>
    </joint>

    <joint name="right_fold_joint" type="revolute">
