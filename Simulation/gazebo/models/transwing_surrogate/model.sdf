        <material>
          <ambient>0.90 0.38 0.06 1</ambient>
          <diffuse>1.00 0.48 0.08 1</diffuse>
        </material>
      </visual>
    </link>

    <link name="left_aileron_link">
      <pose relative_to="left_wing_link">-0.15 0.51 0 0 0 0</pose>
      <inertial>
        <pose>-0.04 0 0 0 0 0</pose>
        <mass>0.06</mass>
        <inertia>
          <ixx>0.00125</ixx>
          <iyy>0.00004</iyy>
