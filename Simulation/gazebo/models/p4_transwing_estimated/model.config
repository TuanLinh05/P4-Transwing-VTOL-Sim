<?xml version="1.0"?>
<model>
  <name>P4 Transwing estimated</name>
  <version>0.1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <author>
    <name>Local simulation project</name>
  </author>
  <description>
    Gazebo Harmonic model derived from the supplied X-P4 visualization mesh.
    Dimensions published in the X-P4 UAFM are used where available; inertia,
    aerodynamic coefficients and propeller constants are engineering estimates.
  </description>
</model>
